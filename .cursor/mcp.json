{
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "uproot": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "ghcr.io/eic/uproot-mcp-server:latest"
      ]
    },
    "zenodo": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "ghcr.io/eic/zenodo-mcp-server:latest"
      ]
    },
    "xrootd": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "XROOTD_SERVER=root://dtn2304.jlab.org:8443",
        "-e",
        "XROOTD_BASE_DIR=/jlab-osdf-ro/eic/EPIC/volatile",
        "ghcr.io/eic/xrootd-mcp-server:latest"
      ]
    }
  }
}
