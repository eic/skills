{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eic/skills/schemas/skill.schema.json",
  "title": "EIC Skill Definition",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "pattern": "^eic\\.ai/v[0-9]+$"
    },
    "kind": {
      "const": "Skill"
    },
    "metadata": {
      "type": "object",
      "required": ["id", "name", "version", "owners", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "name": { "type": "string", "minLength": 3 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "owners": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "required": ["purpose", "procedure", "constraints", "inputs", "outputs", "examples"],
      "properties": {
        "purpose": { "type": "string", "minLength": 10 },
        "procedure": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 5 }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 5 }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 2 }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["prompt", "outcome"],
            "properties": {
              "prompt": { "type": "string", "minLength": 8 },
              "outcome": { "type": "string", "minLength": 8 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

